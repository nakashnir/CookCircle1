# --- Required ---
# Postgres connection string. Replit provisions DATABASE_URL automatically when
# you add a Replit Postgres database; copy that value here for local runs.
DATABASE_URL=postgres://user:password@host:5432/cookcircle

# Express session secret (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# --- Optional: media adapter ---
# When all three CLOUDINARY_* vars are set, the API uploads donation images to
# Cloudinary. Otherwise the local fallback returns deterministic picsum URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: location adapter (server-side) ---
# Set GOOGLE_MAPS_API_KEY to enable real geocoding (Google Geocoding API).
# Without it the API uses deterministic pseudo-coordinates in fallback/demo mode —
# distance calculation and OpenStreetMap previews still work end-to-end.
GOOGLE_MAPS_API_KEY=

# --- Optional: location adapter (browser-side) ---
# Set VITE_GOOGLE_MAPS_PUBLIC_KEY to enable Google Places Autocomplete in the
# address form. This is a separate, browser-safe key from GOOGLE_MAPS_API_KEY.
VITE_GOOGLE_MAPS_PUBLIC_KEY=
